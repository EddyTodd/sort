include_guard(GLOBAL)

# Retained pre-migration empirical executables.  They intentionally remain
# outside the installed/public sortlab target and exist only to reproduce or
# compare historical evidence until EddyTodd/bench migration acceptance passes.
function(sortlab_research_executable target source)
  add_executable(${target} ${source})
  target_link_libraries(${target} PRIVATE sortlab::sortlab)
  target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/research/include)
  set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
  sortlab_apply_warnings(${target})
  if(NOT target STREQUAL "sort_alloc")
    sortlab_apply_sanitizers(${target})
  endif()
endfunction()

sortlab_research_executable(sort_lab research/apps/sort_lab.cpp)
sortlab_research_executable(sort_records research/apps/sort_records.cpp)
sortlab_research_executable(sort_cutoffs research/apps/sort_cutoffs.cpp)
sortlab_research_executable(sort_perf research/apps/sort_perf.cpp)
sortlab_research_executable(sort_alloc research/apps/sort_alloc.cpp)
sortlab_research_executable(sort_tiny research/apps/sort_tiny.cpp)
sortlab_research_executable(sort_leaf_hybrids research/apps/sort_leaf_hybrids.cpp)
sortlab_research_executable(sort_merge_policies research/apps/sort_merge_policies.cpp)
sortlab_research_executable(sort_merge_kernels research/apps/sort_merge_kernels.cpp)
