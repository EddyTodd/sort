{
  "schema_version": 1,
  "campaign_id": "external-v1",
  "description": "Tier-2 comparison track for provenance-pinned engineered external sorters against paired sortlab and standard-library controls.",
  "experiments": [
    {
      "id": "engineered-external-core",
      "binary": "sort_external",
      "purpose": "Compare pdqsort, branchless pdqsort, sequential IPS4o, and paired internal/library controls on identical deterministic inputs.",
      "repetitions": 2,
      "args": [
        "--trials", "51", "--warmups", "2",
        "--algorithms", "pdqsort,pdqsort_branchless,ips4o_sequential,intro,quick_3way,radix_lsd_11,std_sort",
        "--patterns", "random,sorted,reversed,few_unique,binary,all_equal,nearly_sorted,organ_pipe,sawtooth,runs,descending_runs,rotated,alternating_extremes,staggered,plateau",
        "--sizes", "16,24,32,48,64,96,128,192,256,512,1024,2048,4096,8192,16384,32768,65536,131072,262144,524288,1048576"
      ],
      "analysis": [
        ["python3", "tools/analyze.py", "{raw}", "--baseline", "std_sort", "--bootstrap", "5000", "--output", "{run_dir}/summary.csv"],
        ["python3", "tools/crossovers.py", "{run_dir}/summary.csv", "--output", "{run_dir}/crossovers.csv"]
      ]
    }
  ]
}
