{
  "schema_version": 1,
  "campaign_id": "merge-policies-v1",
  "description": "Tier-2 factorial study of stable adaptive merge scheduling and minrun policy. The merge kernel is held common so policy and run-sizing effects are isolated.",
  "experiments": [
    {
      "id": "merge-policy-factorial",
      "binary": "sort_merge_policies",
      "purpose": "Test pairwise, repaired TimSort-stack, and Powersort merge schedules crossed with none/classic/balanced minrun policies on identical inputs.",
      "repetitions": 2,
      "args": [
        "--trials", "51", "--warmups", "2",
        "--policies", "pairwise,timsort_stack,powersort",
        "--minruns", "none,classic,balanced",
        "--patterns", "random,sorted,reversed,few_unique,nearly_sorted,runs,descending_runs,run_equal32,run_long_short,run_power_skew,run_fibonacci,run_alternating_direction",
        "--sizes", "32,48,64,96,128,192,256,315,512,1024,2048,4096,8192,16384,32768,65536,131072,262144,524288,1048576"
      ],
      "analysis": [
        ["python3", "tools/analyze_merge_policies.py", "{raw}", "--baseline-policy", "powersort", "--baseline-minrun", "balanced", "--bootstrap", "5000", "--output", "{run_dir}/summary.csv"]
      ]
    }
  ]
}
