{
  "schema_version": 1,
  "campaign_id": "merge-kernels-v1",
  "description": "Tier-2 adaptive merge-kernel experiment with Powersort scheduling and balanced minrun held fixed while buffer strategy and galloping vary.",
  "experiments": [
    {
      "id": "adaptive-merge-kernels",
      "binary": "sort_merge_kernels",
      "purpose": "Measure full-buffer versus smaller-run buffering and linear versus galloping merge search without changing run detection, minrun, or merge scheduling.",
      "repetitions": 2,
      "args": [
        "--trials", "51", "--warmups", "2",
        "--gallop-thresholds", "4,7,12,16",
        "--patterns", "random,sorted,reversed,few_unique,nearly_sorted,runs,descending_runs,run_equal32,run_long_short,run_power_skew,run_fibonacci,run_alternating_direction",
        "--sizes", "64,96,128,192,256,315,512,1024,2048,4096,8192,16384,32768,65536,131072,262144,524288,1048576"
      ],
      "analysis": [
        ["python3", "tools/analyze_merge_kernels.py", "{raw}", "--baseline", "smaller_gallop_7", "--bootstrap", "5000", "--output", "{run_dir}/merge-kernel-summary.csv"],
        ["python3", "tools/tune_gallop.py", "{raw}", "--output", "{run_dir}/gallop-heldout.csv"]
      ]
    }
  ]
}
