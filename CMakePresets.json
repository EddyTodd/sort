{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer Debug",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Sanitized Debug",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "SORTLAB_ENABLE_SANITIZERS": "ON",
        "SORTLAB_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "package",
      "displayName": "Release Package Install",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/package",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/package-prefix"
      }
    },
    {
      "name": "retained-research",
      "displayName": "Retained Research Reproduction",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/retained-research",
      "cacheVariables": {
        "SORTLAB_BUILD_RETAINED_RESEARCH": "ON",
        "SORTLAB_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev", "configuration": "Debug"},
    {"name": "release", "configurePreset": "release", "configuration": "Release"},
    {"name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug"},
    {"name": "package", "configurePreset": "package", "configuration": "Release", "targets": ["install"]},
    {"name": "retained-research", "configurePreset": "retained-research", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "package", "configurePreset": "package", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "retained-research", "configurePreset": "retained-research", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}
